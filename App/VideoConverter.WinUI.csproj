<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier>win-$(LumaRecodeArchitecture)</RuntimeIdentifier>
    <PlatformTarget>$(LumaRecodeArchitecture)</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>LumaRecode.ico</ApplicationIcon>
    <AssemblyName>LumaRecode</AssemblyName>
    <Title>映码 · LumaRecode WBNEXT</Title>
    <Product>映码 · LumaRecode WBNEXT</Product>
    <Description>视频转码与色彩转换</Description>
    <RootNamespace>VideoConverter</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Version>5.0.0</Version>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <NuGetLockFilePath Condition="'$(LumaRecodeArchitecture)' == 'arm64'">packages.arm64.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <NuGetLockFilePath>packages.aot.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(LumaRecodeArchitecture)' == 'arm64'">packages.arm64.aot.lock.json</NuGetLockFilePath>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
  </PropertyGroup>
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <LinkerArg Include="/PDBALTPATH:LumaRecode.pdb" />
  </ItemGroup>
  <ItemGroup>
    <!-- WinUI's content glob must not ship the other architecture's codec. -->
    <Content Remove="Native/**" />
    <None Remove="Native/**" />
    <ProjectReference Include="../Core/LumaRecode.Core.csproj" />
    <ProjectReference Include="../Interop/LumaRecode.Native.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <Content Include="LumaRecode.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Brand/LumaRecode.png" Link="Assets/LumaRecode.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Fonts/*.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Native/$(LumaRecodeArchitecture)/uhdr.dll" Link="uhdr.dll" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Strings.en.json" LogicalName="LumaRecode.Strings.en.json" WithCulture="false" />
    <EmbeddedResource Include="Strings.ja.json" LogicalName="LumaRecode.Strings.ja.json" WithCulture="false" />
    <EmbeddedResource Include="Strings.es.json" LogicalName="LumaRecode.Strings.es.json" WithCulture="false" />
    <EmbeddedResource Include="../Assets/recommended-presets.json" LogicalName="VideoConverter.EncodingPresets.json" />
    <!-- Files read by path are deployment files, not MRT-qualified UI resources. -->
    <None Include="../Assets/**" Link="Assets/Media/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(LumaLicenseDirectory)/**" Link="licenses/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
