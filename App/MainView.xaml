<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:VideoConverter" x:Class="VideoConverter.MainView">
  <Grid.Resources>
    <!-- The preview sits over the page, so it needs a surface of its own rather than the
         translucent card brush the rest of the layout uses. -->
    <SolidColorBrush x:Key="PreviewSurfaceBrush" Color="#F218181C" />
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="24" />
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Secondary" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="LogTextBoxStyle" TargetType="local:LogTextBox" BasedOn="{StaticResource DefaultTextBoxStyle}" />
    <Style x:Key="PathTextBoxStyle" TargetType="local:PathTextBox" BasedOn="{StaticResource DefaultTextBoxStyle}" />
    <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="20,6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="AccentActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="20,6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <Grid x:Name="TitleDrag" Margin="16,0,150,0">
    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsHitTestVisible="False">
      <Image Source="ms-appx:///Assets/LumaRecode.png" Width="20" Height="20" /><TextBlock Text="映码 · LumaRecode" FontSize="12" VerticalAlignment="Center" x:Name="LocalizedElement0" />
    </StackPanel>
  </Grid>
  <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Padding="32,20,32,24">

    <Grid>
    <StackPanel Spacing="24" MaxWidth="1240" HorizontalAlignment="Stretch">
      <Grid ColumnSpacing="24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Spacing="4"><TextBlock Text="映码" FontSize="30" FontWeight="SemiBold" x:Name="LocalizedElement1" /><TextBlock Text="LumaRecode · 视频转码与色彩转换" Style="{StaticResource Secondary}" x:Name="LocalizedElement2" /></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <DropDownButton x:Name="LanguageButton" MinHeight="36" VerticalAlignment="Center" AutomationProperties.Name="界面语言" />
          <Button x:Name="PaletteButton" Width="40" Height="36" Padding="0" ToolTipService.ToolTip="界面配色" AutomationProperties.Name="界面配色"><FontIcon Glyph="" FontSize="18" /></Button>
          <Button x:Name="ToolsButton" Width="40" Height="36" Padding="0" ToolTipService.ToolTip="工具路径" AutomationProperties.Name="工具路径"><FontIcon Glyph="" FontSize="18" /></Button>
          <Button x:Name="AboutButton" Width="40" Height="36" Padding="0" ToolTipService.ToolTip="关于" AutomationProperties.Name="关于"><FontIcon Glyph="" FontSize="18" /></Button>
        </StackPanel>
      </Grid>
      <SelectorBar x:Name="WorkPage">
        <SelectorBarItem x:Name="VideoPage" Text="视频转换" IsSelected="True" />
        <SelectorBarItem x:Name="PhotoPage" Text="图片与动态照片" />
      </SelectorBar>
      <Grid x:Name="SettingsGrid" ColumnSpacing="24" RowSpacing="24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="380" /><ColumnDefinition Width="*" MinWidth="300" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Grid.ColumnSpan="2" Style="{StaticResource Card}" AllowDrop="True" x:Name="SourceCard">
          <StackPanel Spacing="20">
            <Grid><TextBlock Text="视频素材" Style="{StaticResource Section}" VerticalAlignment="Center" x:Name="LocalizedElement10" /><Border HorizontalAlignment="Right" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="10,4"><TextBlock x:Name="SourceBadge" Text="等待添加" Style="{StaticResource Secondary}" FontSize="12" VerticalAlignment="Center" /></Border></Grid>
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <local:PathTextBox Style="{StaticResource PathTextBoxStyle}" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" x:Name="InputPath" PlaceholderText="拖入视频，或粘贴文件路径" AutomationProperties.Name="视频路径" />
              <Button x:Name="ChooseInput" Grid.Column="1" Style="{StaticResource AccentActionButtonStyle}" MinWidth="116">
                <!-- An explicit TextBlock follows the same font/fallback policy as
                     the view instead of a template-generated string presenter. -->
                <!-- Source Han's line box has more space above the visible glyphs.
                     Keep layout height unchanged and shift only the label up by 1 DIP. -->
                <TextBlock x:Name="ChooseInputLabel" Text="选择视频" FontWeight="Normal" Margin="{StaticResource ControlTextOpticalMargin}" />
              </Button>
            </Grid>
            <Grid x:Name="SourceDetails" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Width="48" Height="48" VerticalAlignment="Top"><FontIcon Glyph="" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /></Border>
              <StackPanel x:Name="SourceInfo" Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                <TextBlock x:Name="SourceSummary" Text="尚未选择素材" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                <TextBlock x:Name="SourceVideo" Visibility="Collapsed" Style="{StaticResource Secondary}" />
                <TextBlock x:Name="SourceColor" Visibility="Collapsed" Style="{StaticResource Secondary}" />
                <TextBlock x:Name="SourceAudio" Visibility="Collapsed" Style="{StaticResource Secondary}" />
                <TextBlock x:Name="SourceEvidence" Text="识别相机 Log、HDR 与常规 SDR。" Style="{StaticResource Secondary}" />
              </StackPanel>
              <StackPanel x:Name="SourceInterpretation" Grid.Column="2" Spacing="12">
                <ComboBox x:Name="InputKind" Header="输入解释" HorizontalAlignment="Stretch" AutomationProperties.Name="输入解释" />
                <ComboBox x:Name="Profile" Header="相机曲线" HorizontalAlignment="Stretch" AutomationProperties.Name="相机曲线" />
              </StackPanel>
            </Grid>
            <ToggleButton x:Name="ShowPreview" Content="预览与逐帧裁剪" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
        <Border x:Name="PhotoSettings" Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Card}" Visibility="Collapsed">
          <StackPanel Spacing="16">
            <TextBlock x:Name="PhotoHeading" Text="图片导出" Style="{StaticResource Section}" />
            <ComboBox x:Name="ImageFormat" Header="图片格式" HorizontalAlignment="Stretch" />
            <TextBlock x:Name="ImageFormatNote" Style="{StaticResource Secondary}" />
            <Slider x:Name="ImageQuality" Header="图片质量" Minimum="1" Maximum="100" Value="95" StepFrequency="1" SnapsTo="StepValues" />
            <CheckBox x:Name="IncludeMotion" Content="包含动态照片视频" />
            <ComboBox x:Name="MotionEncoder" Header="动态视频编码" HorizontalAlignment="Stretch" Visibility="Collapsed" />
            <ComboBox x:Name="MotionResolution" Header="视频分辨率" HorizontalAlignment="Stretch" Visibility="Collapsed" />
            <TextBlock x:Name="MotionEncoderDetail" Style="{StaticResource Secondary}" Visibility="Collapsed" />
            <TextBlock x:Name="MotionFieldsHint" Style="{StaticResource Secondary}"
                       Text="动态照片的范围在预览面板中选择：打开预览，用两个按钮把当前帧设为开始或结束。" />
            <TextBlock x:Name="PhotoWarning" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border x:Name="OutputCard" Grid.Row="2" Style="{StaticResource Card}">
          <StackPanel Spacing="20">
            <StackPanel Orientation="Horizontal" Spacing="12"><Border Width="32" Height="32" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><SymbolIcon Symbol="Save" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /></Border><TextBlock Text="输出与压缩" Style="{StaticResource Section}" VerticalAlignment="Center" x:Name="LocalizedElement19" /></StackPanel>
            <RadioButtons x:Name="OutputRange" Header="动态范围" MaxColumns="2" SelectedIndex="0" AutomationProperties.Name="动态范围"><RadioButton x:Name="SdrChoice" Content="SDR · 通用播放" /><RadioButton x:Name="HdrChoice" Content="HDR · 保留高光" /></RadioButtons>
            <TextBlock x:Name="TargetNote" Style="{StaticResource Secondary}" />
            <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <ComboBox x:Name="Purpose" Header="用途" HorizontalAlignment="Stretch" AutomationProperties.Name="用途" />
              <ComboBox x:Name="Codec" Grid.Column="1" Header="视频编码" HorizontalAlignment="Stretch" AutomationProperties.Name="视频编码" />
            </Grid>
            <ComboBox x:Name="Variant" Header="质量档" HorizontalAlignment="Stretch" AutomationProperties.Name="质量档" />
            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="16,14"><StackPanel Spacing="6"><TextBlock x:Name="PresetName" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="PresetDetail" Style="{StaticResource Secondary}" /></StackPanel></Border>
          </StackPanel>
        </Border>
        <Border x:Name="ColorSettings" Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}">
          <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="12"><Border Width="32" Height="32" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><SymbolIcon Symbol="Switch" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /></Border><TextBlock Text="色彩转换" Style="{StaticResource Section}" VerticalAlignment="Center" x:Name="LocalizedElement32" /></StackPanel>
            <ComboBox x:Name="Transform" Header="LUT / 色调映射" HorizontalAlignment="Stretch" AutomationProperties.Name="色彩转换" />
            <ComboBox x:Name="DynamicMetadata" Header="动态 HDR" HorizontalAlignment="Stretch" AutomationProperties.Name="动态 HDR" />
            <TextBlock x:Name="DynamicNote" Style="{StaticResource Secondary}" />
            <TextBlock x:Name="TransformNote" Style="{StaticResource Secondary}" />
            <ComboBox x:Name="Sampling" Header="色度采样" HorizontalAlignment="Stretch" AutomationProperties.Name="色度采样" />
            <ComboBox x:Name="BitDepth" Header="位深" HorizontalAlignment="Stretch" AutomationProperties.Name="位深" />
            <ComboBox x:Name="ColorRange" Header="色彩范围" HorizontalAlignment="Stretch" AutomationProperties.Name="色彩范围" />
            <TextBlock x:Name="FormatNote" Style="{StaticResource Secondary}" />
            <Grid x:Name="NoticeRow" ColumnSpacing="8" Visibility="Collapsed">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE7BA;" FontSize="15" VerticalAlignment="Top" Margin="0,2,0,0"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}" />
              <TextBlock x:Name="NoticeText" Grid.Column="1" Style="{StaticResource Secondary}" />
            </Grid>
          </StackPanel>
        </Border>
        <Border x:Name="FormatCard" Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource Card}">
          <StackPanel Spacing="20">
            <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" Spacing="12"><Border Width="32" Height="32" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><SymbolIcon Symbol="List" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /></Border><TextBlock Text="格式与音频" Style="{StaticResource Section}" VerticalAlignment="Center" x:Name="LocalizedElement38" /></StackPanel>
              <CheckBox x:Name="CpuDecode" Grid.Column="1" Content="使用软件解码" VerticalAlignment="Center" />
            </Grid>
            <Grid x:Name="FormatFields" ColumnSpacing="24" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <ComboBox x:Name="Container" Header="封装格式" HorizontalAlignment="Stretch" AutomationProperties.Name="封装格式" />
              <TextBlock x:Name="ContainerNote" Grid.Row="1" Style="{StaticResource Secondary}" />
              <ComboBox x:Name="Audio" Grid.Column="1" Header="音轨" HorizontalAlignment="Stretch" AutomationProperties.Name="音轨" />
              <TextBlock x:Name="AudioNote" Grid.Row="1" Grid.Column="1" Style="{StaticResource Secondary}" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
      <Expander x:Name="LogPanel" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="转换日志">
        <Expander.Header>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <SymbolIcon Symbol="Document" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="转换日志" FontSize="14" VerticalAlignment="Center" x:Name="LocalizedElement44" />
            <Button x:Name="CopyLog" MinWidth="0" MinHeight="28" Padding="8,4" VerticalAlignment="Center" IsEnabled="False" ToolTipService.ToolTip="复制全部日志" AutomationProperties.Name="复制全部日志">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                <TextBlock x:Name="CopyLogLabel" Text="复制" FontWeight="Normal" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Expander.Header>
        <local:LogTextBox x:Name="Log" Style="{StaticResource LogTextBoxStyle}" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="160" FontFamily="Consolas" FontSize="12" ScrollViewer.VerticalScrollBarVisibility="Auto" />
      </Expander>
    </StackPanel>
    </Grid>
  </ScrollViewer>
  <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="32,18,32,20">
    <Grid><StackPanel Spacing="14" MaxWidth="1240" HorizontalAlignment="Stretch">
      <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="保存到" VerticalAlignment="Center" x:Name="LocalizedElement45" /><local:PathTextBox Style="{StaticResource PathTextBoxStyle}" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" x:Name="Destination" Grid.Column="1" PlaceholderText="选择视频后自动生成" AutomationProperties.Name="输出路径" /><Button x:Name="ChooseOutput" Grid.Column="2" Style="{StaticResource ActionButtonStyle}"><TextBlock x:Name="ChooseOutputLabel" Text="更改…" FontWeight="Normal" Margin="{StaticResource ControlTextOpticalMargin}" /></Button></Grid>
      <ProgressBar x:Name="Progress" Minimum="0" Maximum="1000" Value="0" Height="6" />
      <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="ProgressPercent" Text="0% · 00:00 / —" FontWeight="SemiBold" FontSize="12" />
        <TextBlock x:Name="TransferSpeed" Grid.Column="1" Text="速度 —" Style="{StaticResource Secondary}" FontSize="12" />
        <TextBlock x:Name="ElapsedTime" Grid.Column="2" Text="已用 00:00" Style="{StaticResource Secondary}" FontSize="12" />
        <TextBlock x:Name="RemainingTime" Grid.Column="3" Text="剩余 —" Style="{StaticResource Secondary}" FontSize="12" />
      </Grid>
      <Grid x:Name="ActionGrid" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock x:Name="Status" Text="添加素材后开始" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
        <StackPanel x:Name="ActionButtons" Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
          <!-- The default CheckBox padding has a top inset for top-aligned text.
               Use symmetric vertical padding when centering the bundled fonts. -->
          <CheckBox x:Name="NotifyWhenFinished" IsChecked="True" MinWidth="0" Padding="8,0,0,0" VerticalAlignment="Center" VerticalContentAlignment="Center" ToolTipService.ToolTip="转换完成或失败时发送 Windows 通知"><TextBlock x:Name="NotifyWhenFinishedLabel" Text="结束后通知" FontWeight="Normal" VerticalAlignment="Center" Margin="{StaticResource ControlTextOpticalMargin}" /></CheckBox>
          <Button x:Name="OpenFolder" Style="{StaticResource ActionButtonStyle}" IsEnabled="False"><TextBlock x:Name="OpenFolderLabel" Text="打开目录" FontWeight="Normal" Margin="{StaticResource ControlTextOpticalMargin}" /></Button>
          <Button x:Name="Cancel" Style="{StaticResource ActionButtonStyle}" IsEnabled="False"><TextBlock x:Name="CancelLabel" Text="取消" FontWeight="Normal" Margin="{StaticResource ControlTextOpticalMargin}" /></Button>
          <Button x:Name="Start" Style="{StaticResource AccentActionButtonStyle}" MinWidth="140" IsEnabled="False" AutomationProperties.Name="开始转换"><StackPanel Orientation="Horizontal" Spacing="8" Margin="{StaticResource ControlTextOpticalMargin}"><FontIcon Glyph="" FontSize="12" VerticalAlignment="Center" /><TextBlock Text="开始转换" x:Name="LocalizedElement56" VerticalAlignment="Center" FontWeight="Normal" /></StackPanel></Button>
        </StackPanel>
      </Grid>
    </StackPanel></Grid>
  </Border>

  <!-- The root grid has three rows; without this the overlay lands in the 48px title row
       and collapses to nothing, which looks exactly like a button that does nothing. -->
  <Grid x:Name="PreviewOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Background="#CC000000">
    <Border Background="{StaticResource PreviewSurfaceBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="12" Margin="40" Padding="20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <Grid RowSpacing="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock x:Name="PreviewHeading" Text="逐帧预览" Style="{StaticResource Section}" VerticalAlignment="Center" />
          <TextBlock x:Name="PreviewModeNote" Grid.Column="1" Text="SDR 预览" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
          <Button x:Name="ClosePreview" Grid.Column="2" Content="关闭" />
        </Grid>
        <!-- The frame fills whatever the window gives it; Uniform keeps the pixels honest. -->
        <Border Grid.Row="1" Background="Black" CornerRadius="8" MinHeight="240">
          <Grid>
            <Image x:Name="FramePreview" Stretch="Uniform" />
            <ProgressRing x:Name="PreviewBusy" Width="36" Height="36" IsActive="False" />
          </Grid>
        </Border>
        <Slider x:Name="FrameSeek" Grid.Row="2" Minimum="1" Maximum="2" Value="1" StepFrequency="1" SnapsTo="StepValues" IsEnabled="False" AutomationProperties.Name="预览帧" />
        <Grid x:Name="FrameNavigation" Grid.Row="3" ColumnSpacing="12" RowSpacing="8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Button x:Name="PreviousFrame" Content="上一帧" />
          <Button x:Name="NextFrame" Grid.Column="1" Content="下一帧" />
          <Button x:Name="SetTrimStart" Grid.Column="2" Content="设为起始帧" />
          <Button x:Name="SetTrimEnd" Grid.Column="3" Content="设为末尾帧" />
          <TextBox x:Name="FrameNumber" Grid.Row="1" Grid.ColumnSpan="5" Header="跳到（帧号，或 00:01:23.12）" Text="1" MinWidth="220" HorizontalAlignment="Left" Margin="0,4,0,0" />
        </Grid>
        <TextBlock x:Name="PreviewStatus" Grid.Row="4" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
        <Grid Grid.Row="5" RowSpacing="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <CheckBox x:Name="TrimEnabled" Content="裁剪视频" />
          <Grid x:Name="VideoTrimFields" Grid.Row="1" RowSpacing="12" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
              <NumberBox x:Name="TrimStart" Header="开始帧" Minimum="1" Value="1" SmallChange="1" SpinButtonPlacementMode="Compact" />
              <TextBox x:Name="TrimStartText" Header="或输入时间" PlaceholderText="00:01:23.12" />
              <TextBlock x:Name="TrimStartTime" Style="{StaticResource Secondary}" />
            </StackPanel>
            <StackPanel x:Name="TrimEndFields" Grid.Column="1" Spacing="6">
              <NumberBox x:Name="TrimEnd" Header="结束帧（包含）" Minimum="1" Value="1" SmallChange="1" SpinButtonPlacementMode="Compact" />
              <TextBox x:Name="TrimEndText" Header="或输入时间" PlaceholderText="00:01:23.12" />
              <TextBlock x:Name="TrimEndTime" Style="{StaticResource Secondary}" />
            </StackPanel>
          </Grid>
          <Grid x:Name="MotionFields" Grid.Row="1" ColumnSpacing="16" RowSpacing="12" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
              <NumberBox x:Name="MotionStart" Header="视频开始帧" Minimum="1" Value="1" SmallChange="1" SpinButtonPlacementMode="Compact" />
              <TextBox x:Name="MotionStartText" Header="或输入时间" PlaceholderText="00:01:23.12" />
              <TextBlock x:Name="MotionStartTime" Style="{StaticResource Secondary}" />
              <Button x:Name="SetMotionStart" Content="将当前帧设为开始" HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel x:Name="MotionEndFields" Grid.Column="1" Spacing="6">
              <NumberBox x:Name="MotionEnd" Header="视频结束帧（包含）" Minimum="1" Value="1" SmallChange="1" SpinButtonPlacementMode="Compact" />
              <TextBox x:Name="MotionEndText" Header="或输入时间" PlaceholderText="00:01:23.12" />
              <TextBlock x:Name="MotionEndTime" Style="{StaticResource Secondary}" />
              <Button x:Name="SetMotionEnd" Content="将当前帧设为结束" HorizontalAlignment="Stretch" />
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Grid>
