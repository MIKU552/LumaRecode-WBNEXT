# LUTs are text data, but multi-megabyte numeric diffs are not useful in reviews.
*.cube -diff -text
*.ico binary
*.png binary
App/Assets/Fonts/*.ttf binary linguist-vendored=true
App/Native/*.dll binary linguist-vendored=true
App/Native/**/*.dll binary linguist-vendored=true
# Preserve upstream legal text bytes and the hashes in license-manifest.json.
LICENSE -text
NOTICE -text
Assets/**/*.txt -text -whitespace
Assets/OpenOSV/LICENSE -text
Assets/OpenOSV/NOTICE -text
# Retain full upstream legal documents without counting them as application code.
licenses/** -text -whitespace conflict-marker-size=32 linguist-vendored=true
# Shell scripts and native sources keep LF so they run and build on every host.
*.sh text eol=lf
*.rs text eol=lf
*.swift text eol=lf
