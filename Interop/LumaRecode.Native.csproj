<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>VideoConverter.Native</RootNamespace>
    <AssemblyName>LumaRecode.Native</AssemblyName>
    <Version>4.4.3</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <LumaNativeLibraryDirectory Condition="'$(LumaNativeLibraryDirectory)' == ''">$(MSBuildThisFileDirectory)..\artifacts\native\$(LumaRecodeArchitecture)</LumaNativeLibraryDirectory>
  </PropertyGroup>
  <ItemGroup>
    <!-- tools/Build-Native.ps1 writes the DLL here. Absent during a managed-only
         build so this project stays compilable without a Rust toolchain. -->
    <None Include="$(LumaNativeLibraryDirectory)\lumacore.dll" Condition="Exists('$(LumaNativeLibraryDirectory)\lumacore.dll')" Link="lumacore.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(LumaNativeLibraryDirectory)\lumacore.pdb" Condition="Exists('$(LumaNativeLibraryDirectory)\lumacore.pdb')" Link="lumacore.pdb" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
