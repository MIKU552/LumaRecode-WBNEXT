# Keep project source and build inputs; exclude local experiments and generated files.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/README.md
!/LICENSE
!/NOTICE
!/docs/
!/CHANGELOG.md
!/build.ps1
!/global.json
!/LumaRecode.slnx
!/LumaRecode.sln
!/Directory.Build.props
!/.github/
!/native/
!/app-macos/
!/Interop/
!/rust-toolchain.toml
!/Packaging/
!/pyproject.toml
!/tools/
!/licenses/
!/App/
!/Bundle/
!/Core/
!/Assets/
!/Brand/
!/qa/
/App/app.ico
/qa/*
!/qa/README.md
!/qa/LanguageChecks/
!/qa/RuntimeChecks/
!/qa/CliChecks/
!/qa/MemoryChecks/
!/qa/SerializationChecks/
!/qa/FormatChecks/
!/qa/BackendChecks/
!/qa/NativeChecks/
!/qa/PerformanceChecks/
!/qa/TimingChecks/
!/qa/HdrChecks/
!/qa/FrameChecks/
!/qa/DocumentationChecks/
!/qa/BuildChecks/
**/bin/
**/obj/
**/__pycache__/
*.py[cod]
*.user
*.suo
.vs/

# Rust workspace outputs and staged native libraries are rebuilt by the platform scripts.
/native/target/
/artifacts/
**/*.rs.bk

# Swift/AppKit build outputs and the staged native library inside the app package.
/app-macos/.build/
/app-macos/Libraries/
/app-macos/dist/
*.dmg
DerivedData/
